root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2
indent_style = space

[*.{json,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[*.xml]
indent_style = tab

[Makefile]
indent_style = space
